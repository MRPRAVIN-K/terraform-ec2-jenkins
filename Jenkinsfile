pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo 'Code checkout झालं'
            }
        }
        stage('Build') {
            steps {
                echo 'Build स्टेज चालू आहे'
                sh 'ls -la'
            }
        }
        stage('Test') {
            steps {
                echo 'Test स्टेज चालू आहे'
            }
        }
    }
}
